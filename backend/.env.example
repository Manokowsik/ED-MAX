DATABASE_URL=postgresql://postgres:postgres@localhost:5432/training_platform
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=development

# CORS & Application Security
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email Service Configuration
EMAIL_MODE=development
DEV_LOG_AUTH_TOKENS=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@edmax.local
SMTP_TLS=true
SMTP_SSL=false

# Auth Expiration Policies
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
ACTIVATION_TOKEN_EXPIRE_HOURS=48
RESET_TOKEN_EXPIRE_MINUTES=30
